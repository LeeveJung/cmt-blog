TYPO3_CONTEXT=Development/Ddev
#TYPO3_CONTEXT=Production

MAIL_TRANSPORT=smtp
# Use implicit TLS (port 465 + MAIL_SMTP_ENCRYPT=1). With port 587 and an empty value,
# STARTTLS is only opportunistic and not enforced. Never set the string "false" (it is truthy).
MAIL_SMTP_SERVER=hostname:465
MAIL_SMTP_ENCRYPT=1
MAIL_SMTP_USER=noreply@leben-mit-cmt.de
MAIL_SMTP_PASSWORD=secret
MAIL_FROM_ADDRESS=noreply@leben-mit-cmt.de
MAIL_FROM_NAME="Leben mit CMT"

# ddev pull-db: SSH destination (user@host or ~/.ssh/config alias) and TYPO3 project root on the server
REMOTE_SSH_HOST=user@example.com
REMOTE_PATH=/var/www/html
